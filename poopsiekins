<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cleo & Keona — Private Social Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Fredoka', 'sans-serif'],
          },
        }
      }
    };
  </script>
  <style>
    /* Custom scrollbar & utility animations */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.35); border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(148, 163, 184, 0.55); }

    @keyframes floatPet {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-8px) rotate(1.5deg); }
    }
    .pet-float { animation: floatPet 3s ease-in-out infinite; }

    @keyframes coinSpin {
      0% { transform: rotateY(0deg) scale(1); }
      50% { transform: rotateY(900deg) scale(1.25); }
      100% { transform: rotateY(1800deg) scale(1); }
    }
    .coin-anim { animation: coinSpin 1.2s cubic-bezier(0.22, 1, 0.36, 1); }

    @keyframes gachaBurst {
      0% { transform: scale(0.5); opacity: 0; }
      70% { transform: scale(1.06); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .gacha-reveal { animation: gachaBurst 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

    .chat-bg-default-dark {
      background-color: #0b141a;
      background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 0);
      background-size: 24px 24px;
    }
    .chat-bg-default-light {
      background-color: #efeae2;
      background-image: radial-gradient(rgba(0,0,0,0.05) 1px, transparent 0);
      background-size: 24px 24px;
    }
    .chat-bg-aurora {
      background: linear-gradient(135deg, #1e1b4b 0%, #311042 50%, #0f172a 100%);
    }
    .chat-bg-sakura {
      background: linear-gradient(135deg, #fdf2f8 0%, #fbcfe8 50%, #f5d0fe 100%);
    }
    .chat-bg-ocean {
      background: linear-gradient(135deg, #042f2e 0%, #0f172a 60%, #172554 100%);
    }
  </style>
</head>
<body class="bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white overflow-hidden h-screen w-screen">

  <!-- ==================== TOAST NOTIFICATION CONTAINER ==================== -->
  <div id="toast-container" class="fixed top-4 right-4 z-[100] flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- ==================== 1. ROLE LOGIN & PRIVACY LOCK SCREEN ==================== -->
  <div id="login-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 p-4">
    <div class="max-w-md w-full bg-slate-900/90 backdrop-blur-xl border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl text-white">
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-pink-500 to-indigo-500 shadow-lg mb-4">
          <i class="fa-solid fa-comments text-2xl text-white"></i>
        </div>
        <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight">Cleo & Keona</h1>
        <p class="text-slate-400 text-sm mt-1">Private Two-Person World • End-to-End Role Isolation</p>
      </div>

      <!-- Profile Selection Cards -->
      <div class="grid grid-cols-2 gap-4 mb-6">
        <button id="select-cleo-btn" onclick="selectLoginRole('Cleo')" class="role-card group relative flex flex-col items-center p-4 rounded-2xl border-2 border-slate-800 bg-slate-800/50 hover:border-indigo-500 transition-all">
          <img id="login-avatar-Cleo" src="https://placehold.co/120x120/6366f1/ffffff?text=Cleo" alt="Cleo" class="w-16 h-16 rounded-full object-cover border-2 border-indigo-400 mb-2 shadow" />
          <span class="font-bold text-base">Cleo</span>
          <span id="login-lock-badge-Cleo" class="text-[11px] text-slate-400 mt-0.5"><i class="fa-solid fa-lock-open mr-1"></i>Ready</span>
        </button>

        <button id="select-keona-btn" onclick="selectLoginRole('Keona')" class="role-card group relative flex flex-col items-center p-4 rounded-2xl border-2 border-slate-800 bg-slate-800/50 hover:border-pink-500 transition-all">
          <img id="login-avatar-Keona" src="https://placehold.co/120x120/ec4899/ffffff?text=Keona" alt="Keona" class="w-16 h-16 rounded-full object-cover border-2 border-pink-400 mb-2 shadow" />
          <span class="font-bold text-base">Keona</span>
          <span id="login-lock-badge-Keona" class="text-[11px] text-slate-400 mt-0.5"><i class="fa-solid fa-lock-open mr-1"></i>Ready</span>
        </button>
      </div>

      <!-- PIN Gate Box -->
      <div id="pin-entry-box" class="hidden space-y-4 bg-slate-950/70 p-4 rounded-2xl border border-slate-800">
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold text-indigo-300" id="pin-prompt-title">Enter Cleo's 4-Digit PIN</span>
          <span class="text-xs text-slate-400" id="pin-hint-text">Default PIN: 0000 (Change in Profile)</span>
        </div>
        <input id="login-pin-input" type="password" maxlength="6" placeholder="••••" class="w-full text-center tracking-[0.5em] text-xl font-bold bg-slate-900 border border-slate-700 rounded-xl py-3 px-4 focus:outline-none focus:border-indigo-500 text-white" />
        <button onclick="confirmRoleLogin()" class="w-full py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-pink-600 hover:from-indigo-500 hover:to-pink-500 font-semibold text-white shadow-lg transition">
          Unlock & Enter World
        </button>
      </div>

      <p class="text-[11px] text-center text-slate-500 mt-5">
        <i class="fa-solid fa-shield-halved mr-1"></i>Each profile is PIN-protected so neither can access the other's private session, drafts, or receipts settings.
      </p>
    </div>
  </div>

  <!-- ==================== 2. MAIN APP SHELL ==================== -->
  <div id="app-shell" class="hidden h-full w-full flex flex-col overflow-hidden">

    <!-- TOP NAVIGATION BAR -->
    <header class="h-16 shrink-0 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-3 sm:px-5 flex items-center justify-between z-30 shadow-sm">
      <div class="flex items-center gap-3">
        <!-- 3 LINES HAMBURGER BUTTON -->
        <button onclick="toggleDrawer(true)" title="Open Hub Menu" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-100 dark:hover:bg-indigo-900/40 text-slate-700 dark:text-slate-200 transition active:scale-95">
          <i class="fa-solid fa-bars text-lg"></i>
        </button>

        <!-- Partner Info Header (Click to View Partner Bio & Profile) -->
        <div onclick="openPartnerProfileModal()" class="flex items-center gap-2.5 cursor-pointer group">
          <div class="relative">
            <img id="header-partner-avatar" src="https://placehold.co/80x80/ec4899/ffffff?text=K" alt="Partner" class="w-10 h-10 rounded-full object-cover border-2 border-indigo-500/60 group-hover:scale-105 transition" />
            <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-slate-900"></span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h2 id="header-partner-name" class="font-bold text-sm sm:text-base leading-tight">Keona</h2>
              <!-- Live Streak Pill -->
              <button onclick="event.stopPropagation(); switchView('pet')" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30 hover:bg-amber-500/25 transition">
                <span>🔥</span><span id="header-streak-count">0</span>
              </button>
            </div>
            <p id="header-partner-bio-preview" class="text-xs text-slate-500 dark:text-slate-400 truncate max-w-[140px] sm:max-w-[260px]">Tap to view bio & status</p>
          </div>
        </div>
      </div>

      <!-- Right Action Controls -->
      <div class="flex items-center gap-1.5 sm:gap-2.5">
        <!-- Token Wallet Pill -->
        <button onclick="switchView('gacha')" title="Gacha & Tokens" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-indigo-500/10 dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-300 border border-indigo-500/20 text-xs font-bold hover:bg-indigo-500/30 transition">
          <i class="fa-solid fa-coins text-amber-400"></i>
          <span id="header-token-count">0</span>
        </button>

        <!-- Voice & Video Call Buttons -->
        <button onclick="startCall('voice')" title="Voice Call" class="p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-emerald-600 dark:text-emerald-400 transition">
          <i class="fa-solid fa-phone"></i>
        </button>
        <button onclick="startCall('video')" title="Video Call" class="p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-indigo-600 dark:text-indigo-400 transition">
          <i class="fa-solid fa-video"></i>
        </button>

        <!-- Search Chat Toggle -->
        <button onclick="toggleChatSearch()" title="Search Messages" class="p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 transition">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>

        <!-- My Profile & Settings Button -->
        <button onclick="openMyProfileModal()" title="My Profile & Settings" class="flex items-center gap-1.5 pl-1 pr-2 py-1 rounded-full bg-slate-100 dark:bg-slate-800 hover:ring-2 ring-indigo-500 transition">
          <img id="header-my-avatar" src="https://placehold.co/64x64/6366f1/ffffff?text=C" alt="Me" class="w-7 h-7 rounded-full object-cover" />
          <span id="header-my-name" class="hidden md:inline text-xs font-semibold">Cleo</span>
        </button>
      </div>
    </header>

    <!-- ==================== 3-LINES NAVIGATION DRAWER ==================== -->
    <div id="nav-drawer-backdrop" onclick="toggleDrawer(false)" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-40 hidden transition-opacity"></div>
    <aside id="nav-drawer" class="fixed top-0 left-0 bottom-0 w-72 sm:w-80 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 z-50 transform -translate-x-full transition-transform duration-300 flex flex-col">
      <div class="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 to-pink-500 flex items-center justify-center text-white font-bold">
            <i class="fa-solid fa-sparkles"></i>
          </div>
          <div>
            <h3 class="font-display font-bold text-base">Hub Menu</h3>
            <p class="text-[11px] text-slate-500">Logged in as <span id="drawer-role-label" class="font-bold text-indigo-500">Cleo</span></p>
          </div>
        </div>
        <button onclick="toggleDrawer(false)" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <nav class="flex-1 overflow-y-auto p-3 space-y-1 text-sm font-medium">
        <button onclick="switchView('chat')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-semibold">
          <i class="fa-solid fa-comment-dots w-5 text-center"></i> Private Chat & Calls
        </button>

        <div class="pt-2 pb-1 px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400">Play & Arcade</div>
        <button onclick="switchView('games')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-gamepad w-5 text-center text-emerald-500"></i> Online Games (2P)
        </button>
        <button onclick="switchView('solo')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-dice w-5 text-center text-amber-500"></i> Coin Flip & Spin Wheel
        </button>

        <div class="pt-2 pb-1 px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400">Pet, Gacha & Bets</div>
        <button onclick="switchView('pet')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-paw w-5 text-center text-pink-500"></i> Streak Pet & Care
        </button>
        <button onclick="switchView('gacha')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-shirt w-5 text-center text-purple-500"></i> Gacha Outfits (2,510)
        </button>
        <button onclick="switchView('polymarket')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-chart-line w-5 text-center text-cyan-500"></i> Polymarket Bets
        </button>

        <div class="pt-2 pb-1 px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400">Shared Workspace</div>
        <button onclick="switchView('reminders')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-list-check w-5 text-center text-blue-500"></i> Joint Reminders
        </button>
        <button onclick="switchView('calendar')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-calendar-days w-5 text-center text-rose-500"></i> Shared Calendar
        </button>
        <button onclick="switchView('canvas')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-paintbrush w-5 text-center text-orange-500"></i> Collaborative Canvas
        </button>
        <button onclick="switchView('saved-drawings')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-images w-5 text-center text-teal-500"></i> Saved Drawings
        </button>

        <div class="pt-2 pb-1 px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400">Shortcuts & Info</div>
        <button onclick="switchView('apps')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-rocket w-5 text-center text-indigo-500"></i> Hop to Apps
        </button>
        <button onclick="switchView('rules')" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition">
          <i class="fa-solid fa-book-open w-5 text-center text-amber-400"></i> All Rules
        </button>
      </nav>

      <div class="p-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between gap-2">
        <button onclick="toggleTheme()" class="flex-1 py-2 px-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-semibold flex items-center justify-center gap-2 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
          <i id="theme-icon" class="fa-solid fa-sun text-amber-400"></i>
          <span id="theme-label">Light Mode</span>
        </button>
        <button onclick="logoutRole()" class="py-2 px-3 rounded-xl bg-rose-500/15 text-rose-500 text-xs font-semibold hover:bg-rose-500/25 transition">
          <i class="fa-solid fa-right-from-bracket"></i> Switch
        </button>
      </div>
    </aside>

    <!-- ==================== MAIN CONTENT AREA ==================== -->
    <main class="flex-1 relative overflow-hidden flex flex-col">

      <!-- ==================== VIEW 1: MESSENGER & CALLS ==================== -->
      <section id="view-chat" class="view-section h-full flex flex-col overflow-hidden">
        <!-- Search & Refresh Bar (Collapsible) -->
        <div id="chat-search-bar" class="hidden bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-4 py-2 flex items-center gap-2">
          <i class="fa-solid fa-magnifying-glass text-slate-400 text-sm"></i>
          <input id="chat-search-input" oninput="renderMessages()" type="text" placeholder="Search chat history..." class="flex-1 bg-transparent text-sm focus:outline-none" />
          <button onclick="refreshChatHistory()" title="Refresh Chat History" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-semibold hover:bg-indigo-500 hover:text-white transition">
            <i class="fa-solid fa-rotate mr-1"></i>Refresh
          </button>
          <button onclick="openCallHistoryModal()" class="px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
            <i class="fa-solid fa-phone-volume mr-1"></i>Call Logs
          </button>
          <button onclick="toggleChatSearch()" class="p-1 text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Pinned Message Banner -->
        <div id="pinned-message-banner" class="hidden bg-indigo-50 dark:bg-indigo-950/80 border-b border-indigo-200 dark:border-indigo-800/70 px-4 py-2 flex items-center justify-between gap-3">
          <div onclick="scrollToPinnedMessage()" class="flex items-center gap-2.5 cursor-pointer flex-1 min-w-0">
            <i class="fa-solid fa-thumbtack text-indigo-500 text-xs rotate-45"></i>
            <div class="truncate">
              <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase block">Pinned Message</span>
              <p id="pinned-message-text" class="text-xs truncate text-slate-700 dark:text-slate-200"></p>
            </div>
          </div>
          <button onclick="unpinMessage()" title="Unpin" class="text-xs text-slate-400 hover:text-rose-500 p-1"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Chat Messages Stream -->
        <div id="chat-messages-container" class="flex-1 overflow-y-auto p-3 sm:p-5 space-y-3 chat-bg-default-dark bg-cover bg-center">
          <!-- Messages dynamically rendered here -->
        </div>

        <!-- Editing Banner (when editing a sent message) -->
        <div id="editing-banner" class="hidden bg-amber-500/15 border-t border-amber-500/30 px-4 py-1.5 flex items-center justify-between text-xs">
          <span class="text-amber-600 dark:text-amber-300 font-semibold"><i class="fa-solid fa-pen mr-1.5"></i>Editing your message...</span>
          <button onclick="cancelEditMessage()" class="text-slate-500 hover:text-rose-500 font-bold">Cancel</button>
        </div>

        <!-- Stickers & Quick-Words Tray -->
        <div id="sticker-word-tray" class="hidden bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 p-3 max-h-60 overflow-y-auto">
          <div class="flex items-center justify-between mb-2.5 border-b border-slate-200 dark:border-slate-800 pb-2">
            <div class="flex gap-2">
              <button id="tab-btn-stickers" onclick="switchTrayTab('stickers')" class="px-3 py-1 rounded-lg text-xs font-bold bg-indigo-600 text-white">
                <i class="fa-solid fa-face-smile mr-1"></i>Custom Stickers
              </button>
              <button id="tab-btn-words" onclick="switchTrayTab('words')" class="px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                <i class="fa-solid fa-font mr-1"></i>Word Stickers
              </button>
            </div>
            <button onclick="toggleTray()" class="text-slate-400 hover:text-slate-600 px-2"><i class="fa-solid fa-chevron-down"></i></button>
          </div>

          <!-- Stickers Sub-tab -->
          <div id="tray-content-stickers" class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-500">Upload image or short video to create a sticker:</span>
              <label class="cursor-pointer px-2.5 py-1 rounded-lg bg-pink-600 hover:bg-pink-500 text-white text-xs font-semibold">
                <i class="fa-solid fa-plus mr-1"></i>New Sticker
                <input type="file" accept="image/*,video/*" onchange="handleStickerUpload(event)" class="hidden" />
              </label>
            </div>
            <div id="stickers-grid" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2 pt-1"></div>
          </div>

          <!-- Quick-Word Builder Sub-tab -->
          <div id="tray-content-words" class="hidden space-y-2.5">
            <div class="flex gap-2">
              <input id="new-quick-word-input" type="text" placeholder="Add a word (e.g. where, are, you)..." class="flex-1 bg-slate-100 dark:bg-slate-800 rounded-xl px-3 py-1.5 text-xs focus:outline-none focus:ring-2 ring-indigo-500" />
              <button onclick="addQuickWord()" class="px-3 py-1.5 rounded-xl bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-500">Add Word</button>
            </div>
            <p class="text-[11px] text-slate-400">Tap words below to paste them directly into your message box:</p>
            <div id="quick-words-list" class="flex flex-wrap gap-1.5"></div>
          </div>
        </div>

        <!-- Chat Composer Footer -->
        <div class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 p-2.5 sm:p-3 flex items-center gap-2">
          <button onclick="toggleTray()" title="Stickers & Word Builder" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-500/20 text-indigo-500 transition">
            <i class="fa-solid fa-face-grin-stars text-lg"></i>
          </button>

          <!-- Standard Image Upload -->
          <label title="Send Image" class="cursor-pointer p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-emerald-500/20 text-emerald-500 transition">
            <i class="fa-solid fa-image text-lg"></i>
            <input type="file" accept="image/*" onchange="handleSendImage(event, false)" class="hidden" />
          </label>

          <!-- View-Once Image Upload -->
          <label title="Send 1x View-Once Photo" class="cursor-pointer relative p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-amber-500/20 text-amber-500 transition">
            <i class="fa-solid fa-fire-flame-curved text-lg"></i>
