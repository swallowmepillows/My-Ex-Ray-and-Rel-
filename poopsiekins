    let wheelAngle = 0;
    function drawWheel() {
      const canvas = document.getElementById('wheel-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const opts = state.wheelOptions.length ? state.wheelOptions : ['Option 1', 'Option 2'];
      const arc = (Math.PI * 2) / opts.length;
      const colors = ['#6366f1', '#ec4899', '#10b981', '#f59e0b', '#06b6d4', '#8b5cf6'];

      ctx.clearRect(0, 0, 240, 240);
      opts.forEach((label, i) => {
        const angle = wheelAngle + i * arc;
        ctx.beginPath();
        ctx.moveTo(120, 120);
        ctx.arc(120, 120, 115, angle, angle + arc);
        ctx.fillStyle = colors[i % colors.length];
        ctx.fill();
        ctx.save();
        ctx.translate(120, 120);
        ctx.rotate(angle + arc / 2);
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 12px Inter';
        ctx.fillText(label.slice(0, 12), 45, 4);
        ctx.restore();
      });

      document.getElementById('wheel-options-tags').innerHTML = state.wheelOptions.map((o, i) => `
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs">
