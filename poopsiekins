            <div>
              <span class="text-[10px] font-bold uppercase text-purple-400 block">${o.rarity}</span>
              <p class="text-xs font-bold truncate">${o.name}</p>
            </div>
            <button onclick="equipPetOutfit(${o.id})" class="w-full py-1.5 rounded-xl text-xs font-bold ${equipped ? 'bg-emerald-600 text-white' : 'bg-slate-200 dark:bg-slate-800 hover:bg-indigo-600 hover:text-white'}">
