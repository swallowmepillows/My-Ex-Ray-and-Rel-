        showToast('🔒 You sent this 1x photo — only the recipient can open it.');
        return;
      }
      if (msg.opened) {
        showToast('💨 This View-Once photo has already been opened.');
        return;
      }
      document.getElementById('view-once-img').src = msg.mediaUrl;
      document.getElementById('view-once-modal').classList.remove('hidden');

      msg.opened = true;
      if (db && currentUserAuth) {
        await updateDoc(docRef('messages', msgId), { opened: true });
      }
      renderMessages();
    };

    window.closeViewOnceModal = function () {
      document.getElementById('view-once-img').src = '';
      closeModal('view-once-modal');
    };

    function renderMessages() {
      const container = document.getElementById('chat-messages-container');
      const searchQuery = (document.getElementById('chat-search-input')?.value || '').trim().toLowerCase();

      // Update Pinned Banner
      const pinnedBanner = document.getElementById('pinned-message-banner');
      const pinnedMsg = state.messages.find(m => m.id === state.pinnedMessageId && !m.deleted);
      if (pinnedMsg) {
        pinnedBanner.classList.remove('hidden');
        document.getElementById('pinned-message-text').textContent = pinnedMsg.type === 'text' ? pinnedMsg.text : `[${pinnedMsg.type.toUpperCase()}]`;
      } else {
        pinnedBanner.classList.add('hidden');
      }

      const filtered = searchQuery
        ? state.messages.filter(m => (m.text || '').toLowerCase().includes(searchQuery))
        : state.messages;

      container.innerHTML = filtered.map(m => {
        const isMine = m.sender === state.myRole;
        const alignClass = isMine ? 'justify-end' : 'justify-start';
        const bubbleColor = isMine
          ? 'bg-gradient-to-br from-indigo-600 to-indigo-700 text-white rounded-br-sm'
          : 'bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 border border-slate-200 dark:border-slate-700 rounded-bl-sm';

        let bodyHtml = '';
        if (m.deleted) {
          bodyHtml = `<p class="italic text-xs opacity-70"><i class="fa-solid fa-ban mr-1"></i>This message was deleted</p>`;
        } else if (m.type === 'image' && m.viewOnce) {
          bodyHtml = `
            <button onclick="openViewOncePhoto('${m.id}')" class="flex items-center gap-2 px-3 py-2 rounded-xl ${m.opened ? 'bg-black/20 opacity-60' : 'bg-amber-500/25 border border-amber-400/50'} text-xs font-bold">
              <i class="fa-solid ${m.opened ? 'fa-circle-check' : 'fa-fire text-amber-400'}"></i>
              <span>${m.opened ? 'Opened' : '1x View-Once Photo'}</span>
            </button>`;
        } else if (m.type === 'image') {
          bodyHtml = `<img src="${m.mediaUrl}" class="max-w-[220px] sm:max-w-[260px] rounded-xl object-cover" />`;
        } else if (m.type === 'sticker') {
          bodyHtml = m.mediaKind === 'video'
            ? `<video src="${m.mediaUrl}" autoplay loop muted playsinline class="w-28 h-28 rounded-xl object-cover"></video>`
            : `<img src="${m.mediaUrl}" class="w-28 h-28 rounded-xl object-contain" />`;
        } else {
          bodyHtml = `<p class="text-sm break-words whitespace-pre-wrap">${escapeHtml(m.text)}</p>`;
        }

        // WhatsApp Checkmarks & Read Timestamp (only shown if partner hasn't disabled Read Receipts)
        let receiptHtml = '';
        if (isMine && !m.deleted) {
          const partnerReceiptsOn = state.profiles[getPartnerRole()]?.readReceipts !== false;
          if (m.readAt && partnerReceiptsOn) {
            receiptHtml = `<span class="text-sky-300 font-semibold ml-1" title="Seen at ${m.readAt}"><i class="fa-solid fa-check-double"></i> ${m.readAt}</span>`;
          } else {
            receiptHtml = `<span class="opacity-70 ml-1" title="Delivered"><i class="fa-solid fa-check-double"></i></span>`;
          }
        }

        const actionsHtml = !m.deleted ? `
          <div class="opacity-0 group-hover:opacity-100 transition flex items-center gap-1.5 text-[11px] text-slate-400 mt-1 ${isMine ? 'justify-end' : 'justify-start'}">
            <button onclick="pinMessage('${m.id}')" title="Pin" class="hover:text-indigo-400"><i class="fa-solid fa-thumbtack"></i></button>
            ${isMine && m.type === 'text' ? `<button onclick="startEditMessage('${m.id}')" title="Edit" class="hover:text-amber-400"><i class="fa-solid fa-pen"></i></button>` : ''}
            ${isMine ? `<button onclick="deleteOwnMessage('${m.id}')" title="Delete" class="hover:text-rose-400"><i class="fa-solid fa-trash"></i></button>` : ''}
          </div>` : '';

        return `
          <div id="msg-bubble-${m.id}" class="flex ${alignClass} group">
            <div class="max-w-[78%] sm:max-w-[65%]">
              <div class="${m.type === 'sticker' && !m.deleted ? '' : bubbleColor + ' px-3.5 py-2.5 rounded-2xl shadow-xs'}">
                ${bodyHtml}
                <div class="flex items-center justify-end gap-1 text-[10px] opacity-75 mt-1">
                  ${m.edited && !m.deleted ? '<span>(edited)</span>' : ''}
                  <span>${m.timeLabel || ''}</span>
                  ${receiptHtml}
                </div>
              </div>
              ${actionsHtml}
            </div>
          </div>`;
      }).join('');

      if (!searchQuery) container.scrollTop = container.scrollHeight;
    }

    function escapeHtml(str) {
      return (str || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

