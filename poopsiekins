    // -------------------- GACHA SYSTEM (2,510 OUTFITS + JULY 8 & OCT 20 20% DISCOUNT) --------------------
    function isDiscountActive() {
      const sim = document.getElementById('simulate-discount-date')?.checked;
      if (sim) return true;
      const now = new Date();
      const m = now.getMonth() + 1;
      const d = now.getDate();
      return (m === 7 && d === 8) || (m === 10 && d === 20);
    }

    window.updateGachaPrices = function () {
      const disc = isDiscountActive();
      document.getElementById('pull-1-cost').textContent = disc ? '4' : '5';
      document.getElementById('pull-10-cost').textContent = disc ? '40' : '50';
    };

    window.pullGacha = function (count) {
      const disc = isDiscountActive();
      const cost = count === 1 ? (disc ? 4 : 5) : (disc ? 40 : 50);
      const me = state.profiles[state.myRole];
      if (me.tokens < cost) {
        showToast(`🪙 Need ${cost} Tokens! Chat (+1) or win games (+50) to earn more.`);
        return;
      }
      me.tokens -= cost;

      const pulled = [];
      for (let i = 0; i < count; i++) {
        const r = Math.random() * 100;
        let minId = 0, maxId = 999; // Common (0..999)
        if (r < 0.5) { minId = 2500; maxId = 2509; } // Mystery (10)
        else if (r < 5.5) { minId = 2250; maxId = 2499; } // Legendary (250)
        else if (r < 20.5) { minId = 1750; maxId = 2249; } // Rare (500)
        else if (r < 50.5) { minId = 1000; maxId = 1749; } // Uncommon (750)

        const pickedId = Math.floor(Math.random() * (maxId - minId + 1)) + minId;
        if (!state.pet.unlockedOutfitIds.includes(pickedId)) {
          state.pet.unlockedOutfitIds.push(pickedId);
        }
        pulled.push(OUTFIT_CATALOG[pickedId]);
      }

      saveCoreState();
      refreshAllUI();
      renderWardrobe();

      const resPanel = document.getElementById('gacha-result-panel');
      const resGrid = document.getElementById('gacha-results-grid');
      resPanel.classList.remove('hidden');
      resGrid.innerHTML = pulled.map(item => `
        <div class="gacha-reveal p-3 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-indigo-500/30 text-center space-y-1">
          <div class="w-8 h-8 rounded-full mx-auto" style="background:${item.color}"></div>
          <span class="text-[10px] font-black uppercase text-amber-400 block">${item.rarity}</span>
          <p class="text-xs font-bold truncate">${item.name}</p>
        </div>`).join('');
      playBeep(880, 0.15);
    };

    window.renderWardrobe = function () {
      const filter = document.getElementById('wardrobe-filter').value;
      const unlocked = state.pet.unlockedOutfitIds.map(id => OUTFIT_CATALOG[id]).filter(Boolean);
      document.getElementById('wardrobe-count').textContent = unlocked.length;

      const shown = filter === 'ALL' ? unlocked : unlocked.filter(o => o.rarity === filter);
      document.getElementById('wardrobe-grid').innerHTML = shown.map(o => {
        const equipped = state.pet.equippedOutfitId === o.id;
        return `
          <div class="p-3 rounded-2xl border ${equipped ? 'border-indigo-500 bg-indigo-500/10' : 'border-slate-200 dark:border-slate-800'} flex flex-col justify-between gap-2 text-center">
