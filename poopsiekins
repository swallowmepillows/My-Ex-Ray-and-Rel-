    window.onChessSquareClick = function (r, c) {
      const ch = state.games.chess;
      const mySide = ch.whitePlayer === state.myRole ? 'white' : 'black';
      if (ch.turn !== mySide) {
        showToast(`⏳ Wait for ${ch.turn === 'white' ? ch.whitePlayer : ch.blackPlayer}'s move!`);
        return;
      }
      const piece = ch.board[r][c];
      const myPrefix = mySide === 'white' ? 'w' : 'b';

      if (state.selectedChessSq) {
        const sr = state.selectedChessSq.r;
        const sc = state.selectedChessSq.c;
        if (sr === r && sc === c) {
          state.selectedChessSq = null;
          renderChessBoard();
          return;
        }
        if (piece && piece.startsWith(myPrefix)) {
          state.selectedChessSq = { r, c };
          renderChessBoard();
          return;
        }
        const movingPiece = ch.board[sr][sc];
        const targetPiece = ch.board[r][c];
        ch.board[r][c] = movingPiece;
        ch.board[sr][sc] = '';
        state.selectedChessSq = null;

        // Check King capture for victory
        if (targetPiece === 'wK' || targetPiece === 'bK') {
          const winner = state.myRole;
          const loser = getPartnerRole();
          ch.history.unshift({
            date: new Date().toLocaleDateString(),
            white: ch.whitePlayer,
            black: ch.blackPlayer,
            winner,
            loser
