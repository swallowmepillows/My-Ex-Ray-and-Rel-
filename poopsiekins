    // --- PING PONG ---
    let pongAnim = null;
    window.startPongMatch = function () {
      const canvas = document.getElementById('pong-canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = 300;
      canvas.height = 400;
      let ball = { x: 150, y: 200, vx: 3, vy: 3.5, r: 7 };
      let p1X = 115, p2X = 115, pW = 70, pH = 10;
      let s1 = 0, s2 = 0;

      const movePaddle = (clientX) => {
        const rect = canvas.getBoundingClientRect();
        const relX = ((clientX - rect.left) / rect.width) * canvas.width - pW / 2;
        p1X = Math.max(0, Math.min(canvas.width - pW, relX));
      };
      canvas.onmousemove = (e) => movePaddle(e.clientX);
      canvas.ontouchmove = (e) => { e.preventDefault(); movePaddle(e.touches[0].clientX); };

      cancelAnimationFrame(pongAnim);
      function loop() {
        ctx.fillStyle = '#020617';
        ctx.fillRect(0, 0, 300, 400);
        ctx.strokeStyle = '#1e293b';
        ctx.beginPath(); ctx.moveTo(0, 200); ctx.lineTo(300, 200); ctx.stroke();

        // Top paddle AI/partner tracking
        p2X += ((ball.x - pW / 2) - p2X) * 0.085;
        p2X = Math.max(0, Math.min(230, p2X));

        ball.x += ball.vx;
        ball.y += ball.vy;
        if (ball.x < 7 || ball.x > 293) ball.vx *= -1;

        // Paddle collisions
        if (ball.y > 372 && ball.x > p1X && ball.x < p1X + pW) ball.vy = -Math.abs(ball.vy) * 1.03;
        if (ball.y < 28 && ball.x > p2X && ball.x < p2X + pW) ball.vy = Math.abs(ball.vy) * 1.03;

        if (ball.y > 400) { s2++; ball = { x: 150, y: 200, vx: 3, vy: -3.5, r: 7 }; }
        if (ball.y < 0) { s1++; ball = { x: 150, y: 200, vx: -3, vy: 3.5, r: 7 }; }

        ctx.fillStyle = '#ec4899'; ctx.fillRect(p2X, 15, pW, pH);
        ctx.fillStyle = '#6366f1'; ctx.fillRect(p1X, 375, pW, pH);
        ctx.fillStyle = '#facc15'; ctx.beginPath(); ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2); ctx.fill();

        ctx.fillStyle = '#94a3b8'; ctx.font = 'bold 14px Inter';
        ctx.fillText(`${getPartnerRole()}: ${s2}`, 12, 185);
        ctx.fillText(`${state.myRole}: ${s1}`, 12, 222);

        if (s1 >= 5 || s2 >= 5) {
          const winner = s1 >= 5 ? state.myRole : getPartnerRole();
          awardGameWinner(winner, 'Ping Pong');
          return;
        }
        pongAnim = requestAnimationFrame(loop);
      }
      loop();
    };

