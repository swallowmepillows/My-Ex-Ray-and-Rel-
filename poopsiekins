    // -------------------- STREAK PET, HEARTS, REVIVES & BIRTHDAY --------------------
    function incrementDailyStreakOnChat() {
      const today = new Date().toISOString().slice(0, 10);
      if (state.pet.lastChatDate !== today) {
        state.pet.lastChatDate = today;
        state.pet.streak += 1;
        state.pet.hearts = Math.min(5, Math.floor(state.pet.streak / 30));
      }
    }

    window.simulateStreakDay = function () {
      state.pet.streak += 1;
      state.pet.hearts = Math.min(5, Math.floor(state.pet.streak / 30));
      saveCoreState();
      refreshAllUI();
      showToast(`🔥 Streak is now ${state.pet.streak} days!`);
    };

    window.simulateLoseStreak = function () {
      state.pet.streak = 0;
      state.pet.hearts = Math.max(0, state.pet.hearts - 1);
      saveCoreState();
      refreshAllUI();
      showToast('💔 Streak lost! Pet got upset (-1 Heart). Chat 3 days to re-unlock or use a Revive!');
    };

    window.useStreakRevive = function () {
      if (state.pet.revives <= 0) {
        showToast('❌ No revives left this month (0/3)!');
        return;
      }
      state.pet.revives -= 1;
      state.pet.streak = Math.max(3, state.pet.streak + 1);
      saveCoreState();
      refreshAllUI();
      showToast(`✨ Streak revived! (${state.pet.revives}/3 revives remaining this month)`);
    };

    window.triggerPetBirthdayCheck = function () {
      if (!state.pet.birthdayInteractedToday) {
        state.pet.revives = Math.max(0, state.pet.revives - 1);
        saveCoreState();
        refreshAllUI();
        showToast('🎂 On Pet Birthday, streak is safe—but nobody cared for the pet so 1 Revive was deducted!');
