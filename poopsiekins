    window.placePolymarketBet = async function (pollId, choice) {
      const poll = state.polls.find(p => p.id === pollId);
      if (!poll || poll.resolvedWinner) return;
      const amtInput = document.getElementById(`bet-amt-${pollId}`);
      const amount = parseInt(amtInput.value, 10);
      if (!amount || amount <= 0) {
        showToast('Enter a valid token amount to bet!');
        return;
      }
      const me = state.profiles[state.myRole];
      if (me.tokens < amount) {
        showToast('❌ Not enough tokens!');
        return;
      }
      me.tokens -= amount;
      poll.bets[state.myRole] = { choice, amount };
      saveCoreState();
      if (db && currentUserAuth) {
        await updateDoc(docRef('polls', pollId), { bets: poll.bets });
      }
      refreshAllUI();
      showToast(`🎲 Bet ${amount} Tokens on ${choice === 'A' ? poll.optA : poll.optB}!`);
    };

    window.resolvePolymarketPoll = async function (pollId, winningSide) {
      const poll = state.polls.find(p => p.id === pollId);
      if (!poll || poll.resolvedWinner) return;
      const cBet = poll.bets.Cleo;
      const kBet = poll.bets.Keona;
      const totalPot = (cBet?.amount || 0) + (kBet?.amount || 0);

      let winnerRole = null;
      if (cBet && cBet.choice === winningSide) winnerRole = 'Cleo';
      else if (kBet && kBet.choice === winningSide) winnerRole = 'Keona';

      poll.resolvedWinner = winningSide;
      if (winnerRole && totalPot > 0) {
        state.profiles[winnerRole].tokens += totalPot;
        showToast(`💰 ${winnerRole} won the entire pot of ${totalPot} Tokens!`);
      }
      saveCoreState();
      if (db && currentUserAuth) {
        await updateDoc(docRef('polls', pollId), { resolvedWinner: winningSide });
      }
      refreshAllUI();
    };

