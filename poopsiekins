    window.sendMessage = async function (overridePayload = null) {
      if (!state.myRole) return;
      const input = document.getElementById('chat-message-input');
      const text = overridePayload ? '' : input.value.trim();
      if (!overridePayload && !text) return;

      // Check if editing an existing sent message
      if (state.editingMsgId && !overridePayload) {
        const target = state.messages.find(m => m.id === state.editingMsgId);
        if (target && target.sender === state.myRole) {
          target.text = text;
          target.edited = true;
          if (db && currentUserAuth) {
            await updateDoc(docRef('messages', target.id), { text, edited: true });
          }
          cancelEditMessage();
          renderMessages();
          showToast('✏️ Message edited!');
          return;
        }
      }

      const newMsg = {
        sender: state.myRole,
        type: overridePayload ? overridePayload.type : 'text',
        text: overridePayload ? '' : text,
        mediaUrl: overridePayload ? overridePayload.mediaUrl : '',
        mediaKind: overridePayload ? (overridePayload.mediaKind || 'image') : '',
        viewOnce: overridePayload ? !!overridePayload.viewOnce : false,
        opened: false,
        timestamp: Date.now(),
        timeLabel: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        readAt: null,
        edited: false,
        deleted: false
      };

      if (!overridePayload) input.value = '';

      // Award +1 Token per message sent & update daily streak
      state.profiles[state.myRole].tokens += 1;
      incrementDailyStreakOnChat();

      if (db && currentUserAuth) {
        await addDoc(colRef('messages'), newMsg);
      } else {
        newMsg.id = 'msg_' + Date.now();
        state.messages.push(newMsg);
        renderMessages();
      }
      saveCoreState();
      refreshAllUI();
    };

