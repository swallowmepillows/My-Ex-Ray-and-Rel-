    window.handleStickerUpload = async function (e) {
      const file = e.target.files[0];
      if (!file) return;
      if (file.type.startsWith('video/')) {
        const reader = new FileReader();
        reader.onload = (ev) => {
          state.stickers.push({ id: 'stk_' + Date.now(), type: 'video', url: ev.target.result });
          saveCoreState();
          renderStickersAndWords();
        };
        reader.readAsDataURL(file);
      } else {
        const dataUrl = await compressImage(file, 200);
        state.stickers.push({ id: 'stk_' + Date.now(), type: 'image', url: dataUrl });
        saveCoreState();
        renderStickersAndWords();
      }
      e.target.value = '';
