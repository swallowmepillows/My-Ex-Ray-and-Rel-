    async function initFirebase() {
      if (!firebaseConfig) return;
      try {
        const app = initializeApp(firebaseConfig);
        auth = getAuth(app);
        db = getFirestore(app);
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
        currentUserAuth = auth.currentUser;
        setupRealtimeListeners();
      } catch (err) {
        console.error('Firebase init fallback to local:', err);
      }
    }

    function setupRealtimeListeners() {
      if (!db || !currentUserAuth) return;

      // 1. Profiles & Shared Hub State
      onSnapshot(docRef('hub_state', 'core'), (snap) => {
        if (snap.exists()) {
          const data = snap.data();
          if (data.profiles) state.profiles = { ...state.profiles, ...data.profiles };
          if (data.pinnedMessageId !== undefined) state.pinnedMessageId = data.pinnedMessageId;
          if (data.stickers) state.stickers = data.stickers;
          if (data.quickWords) state.quickWords = data.quickWords;
          if (data.pet) state.pet = { ...state.pet, ...data.pet };
          if (data.games) {
            state.games = { ...state.games, ...data.games };
            if (typeof state.games.chess.board === 'string') {
              state.games.chess.board = JSON.parse(state.games.chess.board);
            }
          }
          if (data.wheelOptions) state.wheelOptions = data.wheelOptions;
          if (data.calendarEvents) state.calendarEvents = data.calendarEvents;
          if (data.callLogs) state.callLogs = data.callLogs;
          updateLoginAvatars();
          if (state.myRole) refreshAllUI();
        }
      }, (err) => console.error(err));

      // 2. Real-time Chat Messages
      onSnapshot(colRef('messages'), (snap) => {
        const prevCount = state.messages.length;
        const incoming = [];
        snap.forEach((d) => incoming.push({ id: d.id, ...d.data() }));
        incoming.sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));

        // Notify if new message from partner arrived
        if (state.myRole && incoming.length > prevCount) {
          const newest = incoming[incoming.length - 1];
          if (newest && newest.sender !== state.myRole) {
            showToast(`💬 ${newest.sender}: ${newest.type === 'text' ? newest.text : 'Sent an attachment'}`);
            playBeep(660, 0.12);
          }
        }
        state.messages = incoming;
        if (state.myRole) {
          markPartnerMessagesRead();
          renderMessages();
        }
      }, (err) => console.error(err));

      // 3. Joint Reminders
      onSnapshot(colRef('reminders'), (snap) => {
        const list = [];
        snap.forEach((d) => list.push({ id: d.id, ...d.data() }));
        list.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
        state.reminders = list;
        if (state.myRole) renderReminders();
      }, (err) => console.error(err));

      // 4. Polymarket Polls
      onSnapshot(colRef('polls'), (snap) => {
        const list = [];
        snap.forEach((d) => list.push({ id: d.id, ...d.data() }));
        list.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
        state.polls = list;
        if (state.myRole) renderPolymarket();
      }, (err) => console.error(err));

      // 5. Saved Drawings
      onSnapshot(colRef('saved_drawings'), (snap) => {
        const list = [];
        snap.forEach((d) => list.push({ id: d.id, ...d.data() }));
        list.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
        state.savedDrawings = list;
        if (state.myRole) renderSavedDrawings();
      }, (err) => console.error(err));

      // 6. Collaborative Canvas Live Sync
      onSnapshot(docRef('hub_state', 'live_canvas'), (snap) => {
        if (snap.exists() && snap.data().dataUrl && !state.isDrawing) {
          loadDataUrlToCanvas(snap.data().dataUrl);
        }
      }, (err) => console.error(err));
    }

