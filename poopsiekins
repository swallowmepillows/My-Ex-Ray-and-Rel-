    };

    window.promptRenamePet = function () {
      const weekMs = 7 * 24 * 60 * 60 * 1000;
      const elapsed = Date.now() - (state.pet.lastRenameTime || 0);
      if (elapsed < weekMs) {
        const daysLeft = Math.ceil((weekMs - elapsed) / (24 * 60 * 60 * 1000));
        showToast(`⏳ You can only rename your pet once a week! (${daysLeft} day(s) left)`);
        return;
      }
      const nextName = prompt('Enter a new name for your Streak Pet:', state.pet.name);
      if (nextName && nextName.trim()) {
        state.pet.name = nextName.trim();
        state.pet.lastRenameTime = Date.now();
        saveCoreState();
        renderPetSection();
        showToast(`🐾 Pet renamed to ${state.pet.name}!`);
      }
    };

