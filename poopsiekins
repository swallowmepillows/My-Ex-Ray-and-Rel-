    function renderCalendar() {
      const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      document.getElementById('calendar-month-title').textContent = `${monthNames[state.calMonth]} ${state.calYear}`;

      const firstDay = new Date(state.calYear, state.calMonth, 1).getDay();
      const daysInMonth = new Date(state.calYear, state.calMonth + 1, 0).getDate();
      let cells = '';
      for (let i = 0; i < firstDay; i++) cells += `<div></div>`;
      for (let d = 1; d <= daysInMonth; d++) {
        const iso = `${state.calYear}-${String(state.calMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
        const hasEv = state.calendarEvents.some(e => e.date === iso);
        cells += `<div class="aspect-square rounded-xl border ${hasEv ? 'border-rose-500 bg-rose-500/15 font-bold text-rose-400' : 'border-slate-200 dark:border-slate-800'} flex flex-col items-center justify-center text-xs">
          <span>${d}</span>
          ${hasEv ? '<span class="w-1.5 h-1.5 rounded-full bg-rose-500 mt-0.5"></span>' : ''}
        </div>`;
      }
      document.getElementById('calendar-grid').innerHTML = cells;
      document.getElementById('calendar-events-list').innerHTML = state.calendarEvents.map(e => `
        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-100 dark:bg-slate-800">
          <span class="font-bold text-rose-400">${e.date}</span>
          <span>${escapeHtml(e.title)}</span>
        </div>`).join('');
    }

    // -------------------- COLLABORATIVE CANVAS & SAVED DRAWINGS --------------------
    window.setCanvasTool = function (tool) {
      state.canvasTool = tool;
      ['brush', 'eraser', 'fill'].forEach(t => {
        document.getElementById(`tool-${t}`).className = t === tool
          ? 'px-3 py-1.5 rounded-xl bg-indigo-600 text-white text-xs font-bold'
          : 'px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-bold';
      });
    };

    function resizeSharedCanvas() {
      const wrap = document.getElementById('shared-canvas-wrapper');
      const canvas = document.getElementById('shared-canvas');
      if (!wrap || !canvas) return;
      const temp = canvas.toDataURL();
      canvas.width = wrap.clientWidth || 600;
      canvas.height = wrap.clientHeight || 400;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      loadDataUrlToCanvas(temp);
    }

    function loadDataUrlToCanvas(dataUrl) {
      const canvas = document.getElementById('shared-canvas');
      if (!canvas || !dataUrl || dataUrl === 'data:,') return;
      const img = new Image();
      img.onload = () => canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
      img.src = dataUrl;
    }

    window.clearSharedCanvas = function (broadcast = false) {
      const canvas = document.getElementById('shared-canvas');
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      if (broadcast) syncSharedDoc('live_canvas', { dataUrl: canvas.toDataURL() });
    };

    function setupCanvasEvents() {
      const canvas = document.getElementById('shared-canvas');
      const ctx = canvas.getContext('2d');

      const getPos = (e) => {
        const rect = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: Math.floor(clientX - rect.left), y: Math.floor(clientY - rect.top) };
      };

      const start = (e) => {
        const { x, y } = getPos(e);
        if (state.canvasTool === 'fill') {
          floodFillCanvas(canvas, x, y, document.getElementById('canvas-color-picker').value);
          syncSharedDoc('live_canvas', { dataUrl: canvas.toDataURL() });
          return;
        }
        state.isDrawing = true;
        state.lastX = x;
        state.lastY = y;
      };

      const move = (e) => {
        if (!state.isDrawing) return;
        e.preventDefault();
        const { x, y } = getPos(e);
        ctx.strokeStyle = state.canvasTool === 'eraser' ? '#ffffff' : document.getElementById('canvas-color-picker').value;
        ctx.lineWidth = document.getElementById('canvas-brush-size').value;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(state.lastX, state.lastY);
        ctx.lineTo(x, y);
        ctx.stroke();
        state.lastX = x;
        state.lastY = y;
      };

      const end = () => {
        if (!state.isDrawing) return;
        state.isDrawing = false;
        syncSharedDoc('live_canvas', { dataUrl: canvas.toDataURL() });
      };

      canvas.addEventListener('mousedown', start);
      canvas.addEventListener('mousemove', move);
      window.addEventListener('mouseup', end);
      canvas.addEventListener('touchstart', start, { passive: false });
      canvas.addEventListener('touchmove', move, { passive: false });
      canvas.addEventListener('touchend', end);
    }

    function floodFillCanvas(canvas, startX, startY, hexColor) {
      const ctx = canvas.getContext('2d');
      const w = canvas.width, h = canvas.height;
      const imgData = ctx.getImageData(0, 0, w, h);
      const data = imgData.data;
      const idx = (startY * w + startX) * 4;
      const sr = data[idx], sg = data[idx + 1], sb = data[idx + 2];

      const fr = parseInt(hexColor.slice(1, 3), 16);
      const fg = parseInt(hexColor.slice(3, 5), 16);
      const fb = parseInt(hexColor.slice(5, 7), 16);
      if (sr === fr && sg === fg && sb === fb) return;

      const stack = [[startX, startY]];
      while (stack.length) {
        const [x, y] = stack.pop();
        if (x < 0 || x >= w || y < 0 || y >= h) continue;
        const p = (y * w + x) * 4;
        if (Math.abs(data[p] - sr) < 25 && Math.abs(data[p + 1] - sg) < 25 && Math.abs(data[p + 2] - sb) < 25) {
          data[p] = fr; data[p + 1] = fg; data[p + 2] = fb; data[p + 3] = 255;
          stack.push([x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]);
        }
      }
      ctx.putImageData(imgData, 0, 0);
    }

    window.saveDrawingToGallery = async function () {
      const canvas = document.getElementById('shared-canvas');
      const entry = {
        dataUrl: canvas.toDataURL('image/png'),
        createdDate: new Date().toLocaleString(),
        createdAt: Date.now(),
        artist: state.myRole
      };
      if (db && currentUserAuth) {
        await addDoc(colRef('saved_drawings'), entry);
      } else {
        entry.id = 'drw_' + Date.now();
        state.savedDrawings.unshift(entry);
        renderSavedDrawings();
      }
      showToast('🎨 Drawing saved to Saved Drawings!');
    };

    window.continueSavedDrawing = function (id) {
      const item = state.savedDrawings.find(d => d.id === id);
      if (!item) return;
      switchView('canvas');
      setTimeout(() => {
        loadDataUrlToCanvas(item.dataUrl);
        syncSharedDoc('live_canvas', { dataUrl: item.dataUrl });
      }, 80);
    };

    function renderSavedDrawings() {
      const grid = document.getElementById('saved-drawings-grid');
      grid.innerHTML = state.savedDrawings.length
        ? state.savedDrawings.map(d => `
          <div class="bg-white dark:bg-slate-900 rounded-3xl p-3 border border-slate-200 dark:border-slate-800 space-y-2">
            <img src="${d.dataUrl}" class="w-full h-40 object-contain bg-white rounded-2xl border border-slate-200" />
            <div class="text-[11px] text-slate-400">Created: ${d.createdDate}</div>
            <div class="flex gap-2">
              <button onclick="continueSavedDrawing('${d.id}')" class="flex-1 py-1.5 rounded-xl bg-indigo-600 text-white text-xs font-bold">Continue</button>
              <a href="${d.dataUrl}" download="cleo-keona-art.png" class="flex-1 py-1.5 rounded-xl bg-emerald-600 text-white text-xs font-bold text-center">Download</a>
            </div>
          </div>`).join('')
        : '<p class="text-slate-400 text-sm col-span-full text-center py-8">No saved drawings yet. Draw on the Collaborative Canvas and click Save!</p>';
    }

    // -------------------- BOOTSTRAP ON WINDOW LOAD --------------------
    window.onload = async function () {
      setupCanvasEvents();
      await initFirebase();
    };
  </script>
</body>
</html>
