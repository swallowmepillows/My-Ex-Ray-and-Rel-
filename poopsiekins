      saveCoreState();
      drawWheel();
    };

    window.removeWheelOption = function (idx) {
      if (state.wheelOptions.length <= 2) return;
      state.wheelOptions.splice(idx, 1);
      saveCoreState();
      drawWheel();
    };

    window.spinCustomWheel = function () {
      let speed = 0.35 + Math.random() * 0.25;
      function animate() {
        wheelAngle += speed;
        speed *= 0.975;
        drawWheel();
        if (speed > 0.003) {
          requestAnimationFrame(animate);
        } else {
          const opts = state.wheelOptions;
          const arc = (Math.PI * 2) / opts.length;
          const normalized = ((Math.PI * 1.5 - wheelAngle) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
          const idx = Math.floor(normalized / arc) % opts.length;
          document.getElementById('wheel-winner-text').textContent = `🎉 Landed on: ${opts[idx]}!`;
        }
      }
      animate();
    };

